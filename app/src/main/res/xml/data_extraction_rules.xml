<?xml version="1.0" encoding="utf-8"?>
<!--
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="heshunt.db"/>
        <include domain="database" path="heshunt.db-shm"/>
        <include domain="database" path="heshunt.db-wal"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="heshunt.db"/>
        <include domain="database" path="heshunt.db-shm"/>
        <include domain="database" path="heshunt.db-wal"/>
    </device-transfer>
</data-extraction-rules>
